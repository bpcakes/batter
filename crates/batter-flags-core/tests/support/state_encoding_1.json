  "writer": [
    {
      "shape": "flag",
      "variant": "on",
      "text": "{\"encoding\":1,\"variant\":\"on\"}"
    },
    {
      "shape": "flag",
      "variant": "off",
      "text": "{\"encoding\":1,\"variant\":\"off\"}"
    },
    {
      "shape": "flag",
      "variant": "express",
      "text": "{\"encoding\":1,\"variant\":\"express\"}"
    },
    {
      "shape": "switch",
      "state": "engaged",
      "text": "{\"encoding\":1,\"switch\":\"engaged\"}"
    },
    {
      "shape": "switch",
      "state": "released",
      "text": "{\"encoding\":1,\"switch\":\"released\"}"
    }
  ],
