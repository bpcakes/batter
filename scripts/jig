#!/bin/sh
# The repository uses Jig only for receipt-free file-budget diagnostics.
set -eu
ROOT_DIR="$(CDPATH= cd "$(dirname "$0")/.." && pwd -P)"
if [ "${1:-}" = "--json" ]; then
  shift
  json=true
else
  json=false
fi
if [ "${1:-}" != "file-budget" ]; then
  printf '%s\n' 'Usage: scripts/jig [--json] file-budget {check|audit|explain|validate} [OPTIONS]' >&2
  exit 2
fi
bin_path="$("$ROOT_DIR/scripts/install-jig.sh" --contract-version 8 --repository-scope --profile runtime)"
cd "$ROOT_DIR"
if [ "$json" = true ]; then
  exec "$bin_path" --json "$@"
fi
exec "$bin_path" "$@"
